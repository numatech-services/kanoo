# ── Base de données ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/numapilot

# Identifiants du conteneur MongoDB (docker-compose). La base n'est plus
# exposée sans authentification.
MONGO_ROOT_USER=kanoo
MONGO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_16




# ── Secrets ──────────────────────────────────────────────────────────────────
# Toute valeur commençant par CHANGE_ME est refusée au démarrage en production.
# Générer chaque secret séparément : openssl rand -hex 32

# Signature des sessions applicatives (minimum 32 caractères)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Signature des jetons de portail (adhérents, fournisseurs).
# Facultatif : dérivé de JWT_SECRET s'il est absent. Le définir isole les deux
# surfaces d'authentification l'une de l'autre.
PORTAL_JWT_SECRET=

# URL de l'application
APP_BASE_URL=http://localhost:3000

# Mode démo lecture seule (optionnel)
# READ_ONLY=true
# NEXT_PUBLIC_READ_ONLY=true

# Désactiver les transactions MongoDB (pour développement sans replica set)
# MONGO_NO_TRANSACTIONS=true

# SMS Niger (optionnel)
# SMS_PROVIDER=console
# SMS_API_KEY=
# SMS_SENDER_ID=NUMAPILOT

# Logs
# LOG_LEVEL=info

# ── Email — Brevo (recommandé) ──────────────────────────────────────────────
EMAIL_PROVIDER=brevo           # brevo | smtp | console
BREVO_API_KEY=xkeysib-...      # Obtenir sur app.brevo.com > API Keys
EMAIL_FROM=NUMAPILOT <noreply@numapilot.ne>

# ── Paiement — PayDunya (Mobile Money Niger) ────────────────────────────────
PAYDUNYA_MODE=test             # test | live
PAYDUNYA_MASTER_KEY=           # Dashboard PayDunya > Paramètres > API Keys
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# ── Support WhatsApp ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_WHATSAPP=+22796000000  # Numéro WhatsApp support NUMAPILOT

# Billetterie — secret de signature des billets (QR). Générer une valeur aléatoire >= 32 caractères.
TICKET_SECRET=

# WhatsApp (envoi des billets) — provider: meta | twilio | console (défaut)
WHATSAPP_PROVIDER=console
# Meta WhatsApp Cloud API :
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Twilio (alternative) :
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Chiffrement des champs sensibles au repos (AES-256-GCM). 32 octets.
# Générer : openssl rand -hex 32   (à défaut, dérivé de JWT_SECRET)
FIELD_ENCRYPTION_KEY=

# ── Rapport CSP ──────────────────────────────────────────────────────────────
# Sans destination, l'en-tête Content-Security-Policy-Report-Only ne collecte
# rien : la directive est présente mais inerte. Renseigner une URL pour
# observer les violations avant de passer la CSP en application stricte.
CSP_REPORT_URI=

# ── Facture certifiée SECeF (Niger) ──────────────────────────────────────────
# Sans ces variables, Kanoo fonctionne en mode « portail » : la facture est
# émise sur sygmef.impots.gouv.ne et les codes sont reportés dans l'application.
# La certification automatique suppose l'agrément DGI du logiciel (voir
# docs/SECEF.md) — les spécifications de l'API sont remises à cette occasion.
SECEF_EMCF_BASE_URL=
SECEF_EMCF_TOKEN=
# Facultatif : « portal » ou « emcf » pour forcer un mode.
SECEF_DRIVER=

# Secret partagé du déclencheur de tâches planifiées (/api/cron).
# Générer : openssl rand -hex 32
CRON_SECRET=
