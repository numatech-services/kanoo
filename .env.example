# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/numapilot




# Sécurité JWT (minimum 32 caractères en production)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MINIMUM_32_CHARS_LONG

# URL de l'application
APP_BASE_URL=http://localhost:3000

# Mode démo lecture seule (optionnel)
# READ_ONLY=true
# NEXT_PUBLIC_READ_ONLY=true

# Désactiver les transactions MongoDB (pour développement sans replica set)
# MONGO_NO_TRANSACTIONS=true

# SMS Niger (optionnel)
# SMS_PROVIDER=console
# SMS_API_KEY=
# SMS_SENDER_ID=NUMAPILOT

# Logs
# LOG_LEVEL=info

# ── Email — Brevo (recommandé) ──────────────────────────────────────────────
EMAIL_PROVIDER=brevo           # brevo | smtp | console
BREVO_API_KEY=xkeysib-...      # Obtenir sur app.brevo.com > API Keys
EMAIL_FROM=NUMAPILOT <noreply@numapilot.ne>

# ── Paiement — PayDunya (Mobile Money Niger) ────────────────────────────────
PAYDUNYA_MODE=test             # test | live
PAYDUNYA_MASTER_KEY=           # Dashboard PayDunya > Paramètres > API Keys
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# ── Support WhatsApp ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_WHATSAPP=+22796000000  # Numéro WhatsApp support NUMAPILOT

# Billetterie — secret de signature des billets (QR). Générer une valeur aléatoire >= 32 caractères.
TICKET_SECRET=

# WhatsApp (envoi des billets) — provider: meta | twilio | console (défaut)
WHATSAPP_PROVIDER=console
# Meta WhatsApp Cloud API :
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Twilio (alternative) :
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Chiffrement des champs sensibles au repos (AES-256-GCM). 32 octets.
# Générer : openssl rand -hex 32   (à défaut, dérivé de JWT_SECRET)
FIELD_ENCRYPTION_KEY=
